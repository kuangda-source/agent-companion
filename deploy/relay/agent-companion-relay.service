[Unit]
Description=Agent Companion authenticated WebSocket relay
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=agentrelay
Group=agentrelay
ExecStart=/opt/agent-companion/relay
Environment=AC_RELAY_CONFIG=/etc/agent-companion/relay.json
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/etc/agent-companion
MemoryMax=256M
TasksMax=64
LimitNOFILE=256
StandardOutput=journal
StandardError=journal
[Install]
WantedBy=multi-user.target
